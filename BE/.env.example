APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Ho_Chi_Minh
SANCTUM_EXPIRATION=10080

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# WebSocket / Broadcasting (Pusher or Laravel Reverb)
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

GEMINI_API_KEY=

AI_PREFERRED_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Cloudinary Storage (Audio files, images, blog covers)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage — Digital file storage (PDF, EPUB) — S3-compatible, free 1GB storage + 2GB bandwidth
# Setup: Supabase Dashboard → Storage → Create bucket (private) → Project Settings → Storage (S3 Access Keys)
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_STORAGE_BUCKET=hcmue-library-files
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3

# Mail — Resend Mail Service (HTTP API - không bị chặn bởi Render Free Tier)
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=


MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MoMo Payment Gateway Config
MOMO_SIMULATION=true
MOMO_PARTNER_CODE=MOMO_PARTNER_CODE_DEMO
MOMO_ACCESS_KEY=MOMO_ACCESS_KEY_DEMO
MOMO_SECRET_KEY=MOMO_SECRET_KEY_DEMO
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/fines
MOMO_IPN_URL=http://localhost:8000/api/momo/ipn

# MoMo Personal Wallet Config (Real Money Transfer)
MOMO_PERSONAL_PHONE=0901234567
MOMO_PERSONAL_NAME=NGUYEN VAN A

# VNPay Sandbox Merchant Config
VNPAY_SIMULATION=true
VNPAY_TMN_CODE=2QXUI4B4
VNPAY_HASH_SECRET=secret
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REDIRECT_URL=http://localhost:5173/fines
VNPAY_IPN_URL=http://localhost:8000/api/vnpay/ipn

